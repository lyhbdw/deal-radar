[Unit]
Description=FeedSentinel Single-User Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/feedsentinel_multi_bot.py
WorkingDirectory=/root
Restart=always
RestartSec=5
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/root
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
